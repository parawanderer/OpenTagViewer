<?xml version="1.0" encoding="utf-8"?>
<!--
    Used on Android 11 (API 30) and older, where android:allowBackup="false" already turns off
    both backup and device-to-device transfer. Like the cloud-backup section of
    data_extraction_rules.xml, it is filled in so that turning allowBackup on later does not
    start copying the tags' keys, their history or the Keystore-encrypted session anywhere.
    data_extraction_rules.xml has the reasons. KeepingAppDataOnThisPhoneTest pins both files.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
