<?xml version="1.0" encoding="utf-8"?>
<!--
    A Find My-certified accessory somebody other than Apple made - a Chipolo, a Pebblebee, an
    eufy tag.

    **Themed greys around unchanged blue, and the split is the point.** The blue cone and the
    white ring are what make this read as "a findable thing" at 24dp; recolouring those to the
    user's accent would leave a themed blob that no longer says anything. The green surround
    carries no meaning at all, so it follows the theme and stops the icon looking like a sticker
    dropped onto the row.

    **This one is not tinted at the point of use**, unlike apple.xml and tag_third_party.xml,
    which are single-colour paths flattened to whatever colour the screen wants. A tint applied
    over this would collapse every path below into one colour and produce exactly the grey blob
    described above - so BeaconIcon owns the tint as well as the resource, and clears it here.
    See BeaconIcon#applyTo.

    **Theme attributes mean this must be loaded with a theme.** ResourcesCompat.getDrawable with
    a null theme draws these paths as nothing at all, which is how the history timeline went
    blank while its screenshot test stayed green. Every load site goes through BeaconIcon, and
    ThemedFindMyIconTest renders it the way the app does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

  <!--
      Scaled about the centre so it fills its box the way apple.xml fills its own.

      The artwork runs from 8 to 40 in a 48 viewport - two thirds of the width - so beside the
      Apple mark, which fills about ninety per cent of its own, it looked like a smaller icon
      rather than a different one. Done as a group transform rather than by rewriting nine sets
      of path data, which is arithmetic nobody can review.
  -->
  <group
      android:pivotX="24"
      android:pivotY="24"
      android:scaleX="1.4"
      android:scaleY="1.4">

  <!--
      One grey, then two translucent steps over it - not three different theme roles.

      **That is how the original is built**: #a5d6a7 and #81c784 are tints of #66bb6a, so the
      disc reads as one soft thing with a ring in it. Mapping the three to unrelated M3 greys
      inverted the ordering and left the disc going dark to near-white inward, which lost the
      softness and very nearly took the white ring around the centre dot with it.

      Overlays also keep the ladder true in both themes for free: white lightens and black
      darkens whatever colorOutline happens to be, so the steps cannot collapse the way two
      independently-resolved attributes can.
  -->
  <path
      android:pathData="M40,24c0,8.84 -7.16,16 -16,16S8,32.84 8,24c0,-5.99 3.28,-11.2 8.15,-13.95C18.47,8.75 21.15,8 24,8s5.53,0.75 7.85,2.05C36.72,12.8 40,18.01 40,24z"
      android:fillColor="?attr/colorOutline"/>
  <!--
      Softened, because colorOutline is a border colour and this is a fill.

      #6F797A over #F5FAFB is about 4:1 - correct for a one-pixel divider and heavy for a 24dp
      disc, which read as a dark blob sitting in a list of light rows. @parawanderer asked for
      these to be lighter.

      A translucent step rather than a lighter attribute, for the same reason the two steps below
      are: it stays relative to whatever colorOutline resolves to, so it keeps working under
      dynamic colours instead of pinning the icon to a fixed grey the rest of the theme has
      moved away from. It also lightens the dark theme, where the surround sits on near-black and
      had contrast to spare.

      0.15 is the largest step that keeps the disc above the 3:1 a graphical object needs: it
      lands at 3.22:1 in light mode against 2.94:1 at 0.20, which is already under. Held there by
      ThemedFindMyIconTest, which also pins the ring-inner-surround ordering this sits at the
      bottom of.
  -->
  <path
      android:pathData="M40,24c0,8.84 -7.16,16 -16,16S8,32.84 8,24c0,-5.99 3.28,-11.2 8.15,-13.95C18.47,8.75 21.15,8 24,8s5.53,0.75 7.85,2.05C36.72,12.8 40,18.01 40,24z"
      android:fillColor="#FFFFFF"
      android:fillAlpha="0.15"/>
  <path
      android:pathData="M24,24m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0"
      android:fillColor="#FFFFFF"
      android:fillAlpha="0.24"/>
  <!-- Darkened back down, so the inner disc sits between the ring and the surround, as it does
       in the original. A second lightening step would stack and overshoot both. -->
  <path
      android:pathData="M24,24m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
      android:fillColor="#000000"
      android:fillAlpha="0.10"/>

  <!-- The cone and the centre, left exactly as they were. -->
  <path
      android:pathData="M31.85,10.05l-2.46,4.36C27.8,13.51 25.96,13 24,13s-3.8,0.51 -5.39,1.41l-2.46,-4.36C18.47,8.75 21.15,8 24,8S29.53,8.75 31.85,10.05z"
      android:fillColor="#00b8d4"/>
  <path
      android:pathData="M28.9,15.29L24,24l-4.9,-8.71C20.55,14.47 22.22,14 24,14S27.45,14.47 28.9,15.29z"
      android:fillColor="#2979ff"/>
  <path
      android:pathData="M24,24m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0"
      android:fillColor="#eceff1"/>
  <path
      android:pathData="M24,24m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"
      android:fillColor="#2979ff"/>
  <path
      android:pathData="M29.39,14.41l-0.49,0.88C27.45,14.47 25.78,14 24,14s-3.45,0.47 -4.9,1.29l-0.49,-0.88C20.2,13.51 22.04,13 24,13S27.8,13.51 29.39,14.41z"
      android:fillColor="#00b0ff"/>
  </group>
</vector>
