<?xml version="1.0" encoding="UTF-8"?>
<!--
    Touch feedback shaped like the thing being touched.

    `?attr/selectableItemBackground` is a rectangle with square corners, which on the tag card's
    action buttons paints a hard-edged grey slab across the icon and its label - conspicuously
    unlike everything else on a card that is rounded throughout.

    Mask-only, so there is no background of its own: the ripple is clipped to the rounded shape
    and the view behind it is untouched. The corner radius matches the card's own.

    Rounded rather than circular because the touch target is the icon *and* its label. Masking
    to the circle alone would leave tapping the word "Refresh" with no feedback at all, on a
    target that still works.
-->
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
