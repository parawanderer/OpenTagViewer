<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="handleClickBack" type="Runnable" />
        <variable name="onClickFetchFromAccount" type="Runnable" />
        <variable name="onClickUnlinkAccount" type="Runnable" />
        <variable name="fetchFromAccountSubtitle" type="String" />
        <variable name="onClickTheme" type="Runnable" />
        <variable name="currentTheme" type="String" />
        <variable name="onClickLanguage" type="Runnable" />
        <variable name="currentLanguage" type="String" />
        <variable name="onClickAnisetteServerUrl" type="Runnable" />
        <variable name="currentAnisetteServerUrl" type="String" />
        <variable name="onClickMapProvider" type="Runnable" />
        <variable name="currentMapProvider" type="String" />
        <variable name="isDebugDataEnabled" type="boolean" />
        <variable name="isShowAppleDevicesEnabled" type="boolean" />
        <variable name="isScanInBackgroundEnabled" type="boolean" />
        <variable name="onClickAppleDevicesHelpLink" type="Runnable" />
        <variable name="isSystemColorsSupported" type="boolean" />
        <variable name="isSystemColorsEnabled" type="boolean" />
    </data>

    <LinearLayout
        android:id="@+id/settings_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/settings_top_toolbar"
            layout="@layout/inline_top_toolbar"
            app:onClickBack="@{handleClickBack}"
            app:pageTitle="@{@string/settings}" />

        <!--
            **This screen did not scroll.** Everything below the fold was simply unreachable -
            not clipped-looking, not scrollable-but-awkward, just gone, with no indication there
            was more. It fitted by luck on a tall enough screen and stopped fitting the moment
            anything was added; the Apple-devices setting and its explanation were what tipped
            it over, taking the debug and system-colours switches off the bottom with them.

            Height 0 with weight 1, so the scrolling area is exactly what is left under the
            toolbar. `fillViewport` so a short list still lays out against the full height
            rather than collapsing to its content.

            **The last row also has to clear the navigation bar.** The theme makes it
            transparent, so this scrolling area runs underneath it, and the debug switch - which
            is last - came to rest behind the gesture pill: drawn, but awkward to tap and on some
            devices not reachable at all. The child below already leaves 20dp under its content,
            which is the visual gap; the bar needs its own space on top of that, and how much is
            a property of the device, so SettingsActivity applies the measured inset as padding
            here. `clipToPadding="false"` is what makes that space scrollable rather than a strip
            that clips the rows passing through it.
        -->
        <ScrollView
            android:id="@+id/settings_scroll_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

        <!--
            One child, because a ScrollView will only take one - the account section and the
            settings section below it are siblings, and wrapping only the first left the second
            outside. That is not a layout warning, it is an InflateException the moment Settings
            is opened.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingTop="20dp"
            android:paddingRight="8dp">

            <include
                android:id="@+id/login_info_container"
                layout="@layout/login_information_settings" />

            <!--
                The third door to the same screen, and the one people go looking for.

                The empty state's button vanishes once anything is imported, and the device
                list's overflow menu is only obvious to somebody who already knows it is there -
                so "how do I get my tags again" is a Settings question, and this is where they
                come to ask it. Placed under the account card because that is what it acts on.
            -->
            <include
                android:id="@+id/settings_fetch_from_account"
                layout="@layout/settings_item_clickable"
                app:icon="@{@drawable/devices_24px}"
                app:onClick="@{onClickFetchFromAccount}"
                app:sectionSubtitle="@{fetchFromAccountSubtitle}"
                app:title="@{@string/icloud_fetch_my_tags}" />

            <!--
                Only shown once there is something to unlink.

                Gone by default rather than shown-and-disabled: this row does not apply at all
                until the account has been linked, and a permanently greyed row in Settings
                reads as a broken feature. Its visibility is set from SettingsActivity when the
                membership lookup answers - see sayWhetherTheAccountIsLinked.
            -->
            <include
                android:id="@+id/settings_unlink_account"
                layout="@layout/settings_item_clickable"
                android:visibility="gone"
                app:icon="@{@drawable/link_off_24px}"
                app:onClick="@{onClickUnlinkAccount}"
                app:sectionSubtitle="@{@string/icloud_unlink_subtitle}"
                app:title="@{@string/icloud_unlink_title}" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <include
                android:id="@+id/setting_app_theme"
                layout="@layout/settings_item_clickable"
                app:icon="@{@drawable/light_mode_24px}"
                app:sectionSubtitle="@{currentTheme}"
                app:title="@{@string/theme}"
                app:onClick="@{onClickTheme}"
                />

            <!--
                Hidden rather than disabled below Android 12: wallpaper colours do not exist
                there, and a switch that cannot be moved invites people to work out why.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="22dp"
                android:paddingTop="10dp"
                android:paddingRight="22dp"
                android:paddingBottom="10dp"
                android:visibility="@{isSystemColorsSupported ? View.VISIBLE : View.GONE}">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/palette_24px" />

                <!--
                    Title and subtitle are TextViews rather than the switch's own label, so the
                    row matches settings_item_clickable exactly. A MaterialSwitch draws its text
                    in Material's type, which next to the Nunito rows above it reads as a
                    different size and weight.
                -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_semi_bold"
                        android:text="@string/use_system_colors"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/use_system_colors_description"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_app_use_system_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:checked="@{isSystemColorsEnabled}"
                    android:contentDescription="@string/use_system_colors"
                    android:enabled="true" />
            </LinearLayout>

            <include
                android:id="@+id/setting_app_language"
                layout="@layout/settings_item_clickable"
                app:icon="@{@drawable/language_24px}"
                app:sectionSubtitle="@{currentLanguage}"
                app:title="@{@string/language}"
                app:onClick="@{onClickLanguage}"
                />

            <!--
                Titled for what it now controls rather than for the server it used to be:
                signing in normally involves no server at all. The subtitle carries whichever
                is in use, so the common case reads "On this device" instead of a URL that no
                longer means anything.
            -->
            <include
                android:id="@+id/setting_app_anisette_server"
                layout="@layout/settings_item_clickable"
                app:icon="@{@drawable/host_24px}"
                app:sectionSubtitle="@{currentAnisetteServerUrl}"
                app:title="@{@string/anisette_provider}"
                app:onClick="@{onClickAnisetteServerUrl}"
                />

            <include
                android:id="@+id/setting_app_map_provider"
                layout="@layout/settings_item_clickable"
                app:icon="@{@drawable/directions_24px}"
                app:sectionSubtitle="@{currentMapProvider}"
                app:title="@{@string/map_provider}"
                app:onClick="@{onClickMapProvider}"
                />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="22dp"
                android:paddingTop="8dp"
                android:paddingRight="22dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:srcCompat="@drawable/smartphone_24px" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_show_apple_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:checked="@{isShowAppleDevicesEnabled}"
                    android:enabled="true"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/show_apple_devices"
                    android:textSize="16sp" />
            </LinearLayout>

            <!--
                Indented to the switch's text, not to the icon, so it reads as belonging to the
                switch rather than as a new setting. The explanation is long on purpose: the whole
                point of the setting is that the incompleteness is invisible otherwise.
            -->
            <TextView
                android:id="@+id/settings_show_apple_devices_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="22dp"
                android:fontFamily="@font/nunito_medium"
                android:text="@string/show_apple_devices_explainer"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_show_apple_devices_help_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/nunito_medium"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/show_apple_devices_help_link"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:onClick="@{() -> onClickAppleDevicesHelpLink.run()}" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="22dp"
                android:paddingTop="8dp"
                android:paddingRight="22dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:srcCompat="@drawable/my_location_24px" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_scan_in_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:checked="@{isScanInBackgroundEnabled}"
                    android:enabled="true"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/scan_in_background"
                    android:textSize="16sp" />
            </LinearLayout>

            <!--
                Indented to the switch's text like its neighbour above. Long on purpose: this is
                the setting that turns a display feature into a recording one, and somebody
                should be able to decide that from the sentence rather than by trying it.
            -->
            <TextView
                android:id="@+id/settings_scan_in_background_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/nunito_medium"
                android:text="@string/scan_in_background_explainer"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="22dp"
                android:paddingTop="8dp"
                android:paddingRight="22dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:srcCompat="@drawable/developer_mode_24px" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_app_debug_data_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:checked="@{isDebugDataEnabled}"
                    android:enabled="true"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/enable_debug_data"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>
