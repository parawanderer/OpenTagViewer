<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
    </data>

    <FrameLayout
        android:id="@+id/device_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <TextView
                    android:id="@+id/list_item_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="👵" />

                <ImageView
                    android:id="@+id/list_item_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/apple"
                    android:tint="?attr/colorOutline"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/list_item_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_medium"
                        android:text="Device Name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/warning_icon"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="0"
                        android:src="@drawable/warning_24px_fill"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/list_item_last_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/last_updated_x"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!--
                Shown only while selecting. A tick alongside the row's tinted background says
                "selected" twice, which is deliberate: the tint alone is easy to miss on a
                wallpaper-derived palette, and the tick alone is easy to miss on a long list.
            -->
            <!--
                Grab here to reorder. On the right, on the thumb side, and away from the icon
                and name so a normal tap cannot land on it by accident.

                An explicit handle rather than long-press-to-drag, which is the usual gesture
                and is already taken: a long press on this row starts selection mode. Two
                different things on one gesture would make both unreliable, so
                setLongPressDragEnabled(false) turns the built-in one off and this is the only
                way in. See MyDevicesListActivity#attachDragToReorder.
            -->
            <ImageView
                android:id="@+id/list_item_drag_handle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="12dp"
                android:contentDescription="@string/reorder_tag"
                android:src="@drawable/drag_handle_24px"
                android:tint="?attr/colorOutline" />

            <ImageView
                android:id="@+id/list_item_selected_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="12dp"
                android:contentDescription="@string/selected"
                android:src="@drawable/check_circle_24px_fill"
                android:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

</layout>