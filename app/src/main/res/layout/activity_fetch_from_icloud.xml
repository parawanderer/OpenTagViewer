<?xml version="1.0" encoding="utf-8"?>
<!--
  Reading the tags on the signed-in Apple account.

  **One screen with steps, not several activities.** The steps share a live iCloud session -
  a keychain session and a CloudKit client, both holding sockets - and that cannot travel in
  an Intent. It is also a single errand from the user's point of view: unlock, look, import.

  Every step is a sibling here and exactly one is visible, the same shape the sign-in screen
  uses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/icloud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
      **The scrolling half.** It takes whatever height is left after the button bar, so a long
      list of devices scrolls rather than pushing the button off the bottom - which is the one
      way this screen could become unusable, and only for the people with the most devices.
    -->
    <ScrollView
        android:id="@+id/icloud_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/icloud_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="@string/icloud_unlock_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp" />

        <!--
            Working. Its own step so nothing else is on screen while a call is in flight.

            **Weighted rather than wrapped, so it centres.** Every other step is content that
            starts under the heading and grows downward; this one is a spinner and a line of text,
            and left to wrap it sat just below the title with the rest of the screen empty beneath
            it - which reads as a screen that failed to finish drawing rather than as one that is
            waiting. Taking the leftover height puts it in the middle of it.

            The weight only does anything while this step is the visible one: a GONE sibling
            takes no space, and the ScrollView's fillViewport is what gives the column a height
            to share out in the first place.
        -->
        <LinearLayout
            android:id="@+id/icloud_loading_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <!--
              The same spinner the sign-in screen uses, configured the same way. Left bare it is
              an arc with square ends and no ring behind it, which at this size reads as a stray
              refresh glyph rather than as something turning.
            -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/icloud_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:hideAnimationBehavior="inward"
                app:showAnimationBehavior="inward"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="2dp" />

            <TextView
                android:id="@+id/icloud_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Fetching…" />

        </LinearLayout>

        <!-- Which device's passcode do you have. Buttons are added per recoverable record. -->
        <LinearLayout
            android:id="@+id/icloud_device_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingBottom="20dp"
                android:text="@string/icloud_unlock_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/nunito_medium"
                android:paddingBottom="8dp"
                android:text="@string/icloud_unlock_choose_device"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/icloud_device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- The passcode itself. One attempt per press; the cap lives beside this. -->
        <LinearLayout
            android:id="@+id/icloud_passcode_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingBottom="20dp"
                android:text="@string/icloud_unlock_body" />

            <!--
              The device just chosen, as the same tile it was chosen from. Recognising it is the
              whole job here - somebody is about to type that device's passcode, and a sentence
              of comma-separated identifiers is harder to match against the thing in their hand.
            -->
            <include
                android:id="@+id/icloud_passcode_device"
                layout="@layout/icloud_device_tile" />

            <FrameLayout
                android:id="@+id/icloud_passcode_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/layout_rounded_less"
                android:backgroundTint="?attr/colorErrorContainer"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/icloud_passcode_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/icloud_passcode_rejected"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:textSize="14sp" />

            </FrameLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedDenseStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/icloud_passcode_hint"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/icloud_passcode_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/icloud_attempts_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="Attempt 1 of 3" />


        </LinearLayout>

        <!--
          Nothing on this account can be recovered from. **Final**, and the import path is the
          answer - so the button that leaves here goes there rather than back to a retry.
        -->
        <LinearLayout
            android:id="@+id/icloud_no_tags_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingBottom="4dp"
                android:text="@string/icloud_no_tags_body" />

            <TextView
                android:id="@+id/icloud_no_tags_shared_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/layout_rounded"
                android:backgroundTint="?attr/colorSurfaceContainerLow"
                android:padding="12dp"
                android:text="@string/icloud_no_tags_shared_note"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!--
              The guide, so the friend can be sent something rather than described at. This
              screen is read by the person who needs a bundle, and the work is somebody else's -
              a link they can forward is the whole difference between advice and a next step.
            -->
            <TextView
                android:id="@+id/icloud_no_tags_wiki_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/icloud_send_your_friend_the_guide"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />


        </LinearLayout>

        <!--
          A service having a bad day. **Deliberately not the screen above**: the advice is the
          opposite one, and telling somebody with a working account that they permanently own
          no tags sends them away for good.
        -->
        <LinearLayout
            android:id="@+id/icloud_retry_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/icloud_retry_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingBottom="4dp"
                android:text="@string/icloud_service_unsure_body" />


        </LinearLayout>

        <!-- What was found, and what was set aside for not being a tag. -->
        <LinearLayout
            android:id="@+id/icloud_results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/icloud_results_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_medium"
                android:paddingBottom="6dp"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Found 3 tags in your Apple account" />

            <TextView
                android:id="@+id/icloud_results_skipped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="2 other items were your own devices" />

            <LinearLayout
                android:id="@+id/icloud_results_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />

            <!--
              **No "import" button, because there is nothing to choose.** Everything on the
              account comes in - this page is an overview of what was found, not a picker. A
              button offering to import would imply the alternative exists, and would leave
              somebody wondering what happens to whatever they did not tick.
            -->

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!--
      **One button, always in the same place.** It was four, one per step, each at the bottom of
      however much content that step happened to have - so it moved up and down the screen as the
      flow went on, which reads as the page jumping about. Relabelled per step instead.

      Outside the ScrollView, so a long list of devices scrolls behind it rather than pushing it
      off the bottom.
    -->
    <LinearLayout
        android:id="@+id/icloud_button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <!--
          Back, beside the thing it goes back from.

          The system back already does this, and system back alone is not an affordance: nothing
          on the passcode step said the device list was still there to return to, so choosing the
          wrong one out of two looked final. Shown only where there is somewhere to go.
        -->
        <Button
            android:id="@+id/icloud_back_button"
            style="?attr/materialIconButtonFilledTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:icon="@drawable/arrow_back_24px"
            app:iconTint="?attr/colorOnSecondaryContainer"
            tools:visibility="visible" />

        <Button
            android:id="@+id/icloud_primary_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_medium"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp"
            tools:text="Unlock" />

    </LinearLayout>

</LinearLayout>
