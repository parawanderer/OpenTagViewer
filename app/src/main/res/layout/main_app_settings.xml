<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/selectLanguageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/language"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <include layout="@layout/language_input" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selectMapProviderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/map_provider"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <include layout="@layout/map_provider_input" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!--
            The Anisette server, which signing in no longer normally needs: Anisette is
            produced on the device itself, and this screen is quieter for it.

            Hidden rather than deleted, and revealed by AppleLoginActivity when local Anisette
            cannot set itself up. Somebody signing in for the first time on a device where that
            fails has no other way to reach this setting - Settings is behind a login - so
            removing it outright would strand exactly the people who need it.
        -->
        <LinearLayout
            android:id="@+id/anisetteRemoteSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!--
            Why this section came back, for somebody who never asked to see it. Without a
            reason attached, a server URL appearing out of nowhere on the sign-in screen reads
            as the app being broken rather than as it working around something.
        -->
        <TextView
            android:id="@+id/anisetteLoginFallbackReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/anisette_login_needs_server"
            android:textColor="?attr/colorOutline"
            android:textSize="13sp"
            android:visibility="gone" />

        <!--
            Only when Apple's library crashes on this phone (issue #232). Nothing in Settings fixes
            that and the cause is not known, so which phone it is is the useful thing to send.
        -->
        <Button
            android:id="@+id/anisetteReportCrashButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/anisette_report_crash"
            android:visibility="gone" />

        <!--
            Only when the emulated Mac could not get Apple's macOS CoreADI. The server below
            would sign in and then fail every location fetch, so what is offered first is the
            file itself: Apple's link to copy, and a way to choose the download once it is on
            the phone. See AnisetteStatus.State.NEEDS_COREADI.
        -->
        <LinearLayout
            android:id="@+id/anisetteCoreAdiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/anisetteCoreAdiLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/anisetteCopyCoreAdiLinkButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anisette_coreadi_copy_link" />

            <TextView
                android:id="@+id/anisetteCoreAdiRejection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/anisetteChooseCoreAdiButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/anisette_choose_apk" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/anisetteRetryCoreAdiButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:id="@+id/selectAnisetteServerUrlTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/anisette_server_url"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/anisetteServerUrlOkIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_weight="0"
                    android:visibility="gone"
                    app:srcCompat="@drawable/check_circle_24px_fill"
                    app:tint="?attr/colorOutline" />

                <ImageView
                    android:id="@+id/anisetteServerUrlErrorIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_weight="0"
                    android:visibility="gone"
                    app:srcCompat="@drawable/warning_24px_fill"
                    app:tint="?attr/colorError" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/anisetteServerUrlProgressIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:hideAnimationBehavior="inward"
                    app:indicatorSize="21dp"
                    app:showAnimationBehavior="inward"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    />


            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/anisette_server_url_input" />

        </LinearLayout>

    </LinearLayout>

</layout>
