<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handleClickBack"
            type="Runnable" />

        <variable
            name="handleClickMenu"
            type="Runnable" />

        <variable
            name="pageTitle"
            type="String" />

        <variable
            name="clickItemHandler"
            type="Runnable" />

        <variable
            name="onClickDeviceName"
            type="Runnable" />

        <variable
            name="deviceName"
            type="String" />

        <variable
            name="onClickDeviceEmoji"
            type="Runnable" />

        <variable
            name="exportedBy"
            type="String" />

        <variable
            name="exportedWith"
            type="String" />

        <variable
            name="exportedAt"
            type="String" />

        <variable
            name="importedAt"
            type="String" />

        <variable
            name="source"
            type="String" />

        <variable
            name="lastScanAttempt"
            type="String" />

        <variable
            name="lastResultAt"
            type="String" />

        <variable
            name="backoffState"
            type="String" />

        <variable
            name="deviceType"
            type="String" />

        <!-- Debug info -->
        <variable
            name="deviceNameOriginal"
            type="String" />

        <variable
            name="deviceEmojiOriginal"
            type="String" />

        <variable
            name="beaconId"
            type="String" />

        <variable
            name="namingRecordId"
            type="String" />

        <variable
            name="namingRecordCreationTime"
            type="String" />

        <variable
            name="namingRecordModificationTime"
            type="String" />

        <variable
            name="namingRecordModifiedBy"
            type="String" />

        <variable
            name="batteryLevel"
            type="String" />

        <!--
            The three rows of the "Over Bluetooth" section: what this phone's own radio heard
            from the tag, as opposed to batteryLevel above, which comes from the iCloud record
            and may be years old.

            Separate variables rather than one line, because they are three different
            measurements and only some of them survive the tag going quiet - see the section
            itself for which, and why signal strength is not among them.
        -->
        <variable
            name="bleLastSeen"
            type="String" />

        <variable
            name="bleSignalStrength"
            type="String" />

        <variable
            name="bleBatteryLevel"
            type="String" />

        <!-- The raw status byte the battery reading above was decoded from, for the debug
             panel. See the row itself for why it is worth showing next to the reading. -->
        <variable
            name="bleStatusByte"
            type="String" />

        <variable
            name="deviceModel"
            type="String" />

        <variable
            name="pairingDate"
            type="String" />

        <variable
            name="productId"
            type="String" />

        <variable
            name="systemVersion"
            type="String" />

        <variable
            name="vendorId"
            type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <include
                android:id="@+id/settings_top_toolbar"
                layout="@layout/inline_top_toolbar_with_button"
                app:onClickBack="@{handleClickBack}"
                app:onClickMenu="@{handleClickMenu}"
                app:pageTitle="@{pageTitle}" />

            <!--
              **Padded at the bottom, and clipToPadding=false so it is scrolled into rather than
              wasted.** The last row here - Vendor Id, under Debug information - ended level with
              the gesture bar, which on a phone means it is half under the reader's thumb and
              looks cut off. The padding is inside the scrolling area, so nothing is lost above:
              it is simply somewhere to scroll to.
            -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingLeft="22dp"
                            android:paddingTop="8dp"
                            android:text="@string/device_settings"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!--
                        Shown only for a tag the app has stopped looking for. It explains the
                        state and offers the one action that can change it - anything found
                        clears the flag - because "no last location known" with no way forward
                        is the reading a user cannot act on.
                    -->
                    <LinearLayout
                        android:id="@+id/device_ignored_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="22dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="22dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/layout_rounded"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/tag_ignored_summary"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/tag_ignored_explanation"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/device_ignored_retry"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/tag_ignored_retry" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/device_settings_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:gravity="center_vertical"
                        android:onClick="@{() -> onClickDeviceName.run()}"
                        android:orientation="horizontal"
                        android:paddingLeft="22dp"
                        android:paddingTop="10dp"
                        android:paddingRight="22dp"
                        android:paddingBottom="10dp">


                        <!--                        <ImageView-->
                        <!--                            android:id="@+id/imageView6"-->
                        <!--                            android:layout_width="wrap_content"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            app:srcCompat="@drawable/apple" />-->

                        <Button
                            android:id="@+id/pick_icon_button"
                            style="?attr/materialIconButtonStyle"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:onClick="@{() -> onClickDeviceEmoji.run()}"
                            android:paddingLeft="0dp"
                            android:paddingTop="0dp"
                            android:paddingRight="0dp"
                            android:paddingBottom="0dp"
                            android:textSize="34sp"
                            app:icon="@drawable/apple"
                            app:iconGravity="textTop"
                            app:iconSize="38dp"
                            app:iconTint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_semi_bold"
                                android:text="@string/device_name"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                tools:text="Settings Title" />

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@{deviceName}"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Setting Subtitle With More Details" />
                        </LinearLayout>

                    </LinearLayout>


                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingLeft="22dp"
                            android:paddingTop="8dp"
                            android:text="@string/device_information"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <include
                        android:id="@+id/device_settings_exported_by"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{exportedBy}"
                        app:title="@{@string/exported_by}" />

                    <include
                        android:id="@+id/device_settings_exported_with"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{exportedWith}"
                        app:title="@{@string/exported_with}" />

                    <include
                        android:id="@+id/device_settings_exported_at"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{exportedAt}"
                        app:title="@{@string/exported_at}" />

                    <include
                        android:id="@+id/device_settings_imported_at"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{importedAt}"
                        app:title="@{@string/imported_at}" />

                    <!--
                        Shown while a rename is on its way to iCloud. Renaming an accessory is a
                        network round trip rather than a local edit, and without this the screen
                        looks like it ignored the change for as long as that takes.
                    -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/device_rename_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!--
                        Shown instead of the three rows above for a tag read from the Apple
                        account: nothing was exported and nothing was imported, so those rows
                        have nothing true to say. Exactly one of the two sets is visible.
                    -->
                    <include
                        android:id="@+id/device_settings_source"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{source}"
                        app:title="@{@string/source}" />

                    <include
                        android:id="@+id/device_settings_device_type"
                        layout="@layout/settings_item_noicon_clickable"
                        app:clickable="@{true}"
                        app:onClick="@{clickItemHandler}"
                        app:sectionSubtitle="@{deviceType}"
                        app:title="@{@string/type}" />


                    <!--
                        Shown only when Type could not be resolved to a name and the record still
                        carries a vendor id worth looking up. Gone the rest of the time, which is
                        almost always - an AirTag or a Chipolo has nothing to explain.
                    -->
                    <TextView
                        android:id="@+id/device_type_lookup_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:paddingLeft="22dp"
                        android:paddingTop="4dp"
                        android:paddingRight="22dp"
                        android:paddingBottom="12dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Vendor 0x0ABC is a Bluetooth SIG company identifier. Tap to look up who makes this."
                        tools:visibility="visible" />

                    <!--
                        What this phone's own radio heard from the tag, in its own section.

                        **Its own section because it is a different source, not a different
                        field.** Everything above comes from the accessory record - Apple's copy,
                        refreshed from the account or frozen into an export - and the section
                        above says so on its "Source" row. These rows come from the tag itself,
                        over the air, measured here. Sitting them among the record's fields made
                        a reading this phone took a minute ago look like one more thing iCloud
                        had said, and put a signal strength under a heading that reads "Battery".

                        The debug panel below has a battery row too, and it stays there: that one
                        is the record's field, which only Apple devices ever refresh, so for a
                        tag imported from a file it is whatever was true when the export was
                        made. The two are never merged, and neither ever falls back to the other.

                        The whole section is GONE until the tag has actually been heard - see
                        DeviceInfoActivity#showWhatWasHeardOverBluetooth - because a tag this
                        phone has never met has nothing to report here, and empty rows would
                        read as "nothing detected", which is a claim nobody can make.
                    -->
                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/device_ble_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/device_ble_header"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingLeft="22dp"
                            android:paddingTop="8dp"
                            android:text="@string/heard_over_bluetooth"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!--
                        When the tag was last heard: "just now" for as long as it is still being
                        heard, then how long ago. This row is what makes the other two readable,
                        since neither says anything about its own age.
                    -->
                    <include
                        android:id="@+id/device_settings_ble_last_seen"
                        layout="@layout/settings_item_noicon_clickable"
                        android:visibility="gone"
                        app:clickable="@{false}"
                        app:sectionSubtitle="@{bleLastSeen}"
                        app:title="@{@string/last_seen}"
                        tools:visibility="visible" />

                    <!--
                        Signal strength, and **the one row here that is not kept**. It describes
                        how strongly the tag was heard at one instant, which is a statement about
                        a distance that no longer exists once the tag has gone quiet - so this
                        row disappears with the live reading while the battery row stays. See
                        NearbyTagLabel for why even a live one is dots rather than a distance.
                    -->
                    <include
                        android:id="@+id/device_settings_ble_signal"
                        layout="@layout/settings_item_noicon_clickable"
                        android:visibility="gone"
                        app:clickable="@{false}"
                        app:sectionSubtitle="@{bleSignalStrength}"
                        app:title="@{@string/signal}"
                        tools:visibility="visible" />

                    <!--
                        Battery, which unlike the signal is worth keeping: a tag that read "low"
                        an hour ago is still low, and for somebody with no Apple device this is
                        the only battery figure that will ever exist. Stays visible with the
                        "Last seen" row above it carrying its age.
                    -->
                    <include
                        android:id="@+id/device_settings_ble_battery"
                        layout="@layout/settings_item_noicon_clickable"
                        android:visibility="gone"
                        app:clickable="@{false}"
                        app:sectionSubtitle="@{bleBatteryLevel}"
                        app:title="@{@string/battery}"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/device_debug_info"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingLeft="22dp"
                                android:paddingTop="8dp"
                                android:text="@string/debug_information"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <include
                            android:id="@+id/settings_debug_last_scan"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{lastScanAttempt}"
                            app:title="@{@string/debug_last_scan_attempt}" />

                        <include
                            android:id="@+id/settings_debug_last_result"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{lastResultAt}"
                            app:title="@{@string/debug_last_result_at}" />

                        <include
                            android:id="@+id/settings_debug_backoff"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{backoffState}"
                            app:title="@{@string/debug_backoff_state}" />

                        <include
                            android:id="@+id/settings_debug_device_name_original"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{deviceNameOriginal}"
                            app:title="@{@string/debug_device_name}" />

                        <include
                            android:id="@+id/settings_debug_device_emoji_original"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{deviceEmojiOriginal}"
                            app:title="@{@string/debug_device_emoji}" />

                        <include
                            android:id="@+id/settings_debug_beacon_id"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{beaconId}"
                            app:title="@{@string/debug_beacon_id}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_id"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{namingRecordId}"
                            app:title="@{@string/debug_naming_record_id}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_create_time"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{namingRecordCreationTime}"
                            app:title="@{@string/debug_naming_record_creation_time}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_modify_time"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{namingRecordModificationTime}"
                            app:title="@{@string/debug_naming_record_modification_time}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_modified_by"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{namingRecordModifiedBy}"
                            app:title="@{@string/debug_naming_record_modifed_by_device}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_battery_level"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{batteryLevel}"
                            app:title="@{@string/debug_battery_level}" />

                        <!--
                            The status byte this phone heard the tag broadcast, raw.

                            **Here to be measured against, not to be read as a battery level.**
                            The "Over Bluetooth" section above decodes bits 6-7 of it per Apple's
                            Table 5-5, which is right for an MFi accessory and wrong for an
                            AirTag: LocationReportFields records that an AirTag advertises 0x90,
                            failing the same table's marker and reserved bits, and that decoding
                            it anyway reads "low" for a tag whose own record says full.

                            Rendered by LocationReportFields.status, so it carries decimal, hex
                            and binary, and appends the Table 5-5 reading only to a byte that
                            actually conforms - which is the comparison this row exists for.
                            Hidden until the tag has been heard.
                        -->
                        <include
                            android:id="@+id/settings_debug_ble_status_byte"
                            layout="@layout/settings_item_noicon_clickable"
                            android:visibility="gone"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{bleStatusByte}"
                            app:title="@{@string/debug_ble_status_byte}"
                            tools:visibility="visible" />

                        <include
                            android:id="@+id/settings_debug_naming_record_device_model"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{deviceModel}"
                            app:title="@{@string/debug_device_model}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_pairing_date"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{pairingDate}"
                            app:title="@{@string/debug_pairing_date}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_product_id"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{productId}"
                            app:title="@{@string/debug_product_id}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_system_version"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{systemVersion}"
                            app:title="@{@string/debug_system_version}" />

                        <include
                            android:id="@+id/settings_debug_naming_record_vendor_id"
                            layout="@layout/settings_item_noicon_clickable"
                            app:clickable="@{true}"
                            app:onClick="@{clickItemHandler}"
                            app:sectionSubtitle="@{vendorId}"
                            app:title="@{@string/debug_vendor_id}" />

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>


        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emoji_picker_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <FrameLayout
                android:id="@+id/emoji_picker_container"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginBottom="-500dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/layout_rounded"
                    android:backgroundTint="?android:attr/colorBackground"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="30dp"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="20dp">

                        <androidx.emoji2.emojipicker.EmojiPickerView
                            android:id="@+id/emoji_picker"
