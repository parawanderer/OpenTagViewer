    <string name="anisette_mode_local_summary">Produced on your phone. Nothing about signing in reaches anyone else, and no outage elsewhere can stop it.</string>
    <string name="anisette_mode_remote_summary">A public Anisette server does it for you. Its operator can see that traffic, and sign-in stops working when their server does.</string>
    <string name="anisette_mode_change_warning">You will have to sign in again. Apple ties a session to whatever produced its sign-in data, so changing this looks like a new device.</string>
